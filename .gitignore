# ===================================
# C++ Project .gitignore
# ===================================

# Compiled Object files
*.o
*.obj
*.slo
*.lo
*.ko
*.elf

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.so.*
*.dylib
*.dll

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Бинарники проекта (добавьте имя вашего исполняемого файла)
Voxet
VoxetGameEngine

# Build directories
build/
Build/
bin/
Bin/
obj/
cmake-build-*/
out/
dist/
build.ninja
.ninja_deps
.ninja_log

# IDE and Editor files
.vscode/
.vs/
.idea/
*.swp
*.swo
*~
.DS_Store
*.bak
*.tmp
.project
.cproject
.settings/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps
.clangd/
.cache/
settings.cfg
*.tmp.json

# Debug files
*.dSYM/
*.su
*.idb
*.pdb
*.ilk

# Core dumps
core
core.*
vgcore.*

# Dependencies
*.d

# Generated documentation
docs/html/
docs/latex/
Doxygen/

# Temporary files
*.log
*.cache
*.temp
*~

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Package managers
*.lock
package-lock.json
yarn.lock

# Test coverage
*.gcda
*.gcno
*.gcov
coverage/
*.coverage

# Profiling
*.prof
gmon.out
callgrind.*

# Assets (опционально - раскомментируйте если не хотите коммитить карты)
# assets/maps/*.json

# Package managers
vcpkg_installed/
conan/

# Temporary files
*.log
*.tmp
*.temp

# Python junk (для твоего редактора карт)
__pycache__/
*.pyc
*.pyo
*.pyd

# Visual Studio во время работы создает огромные базы данных
*.sdf
*.opensdf
*.VC.db
